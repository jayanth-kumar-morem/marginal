target/
node_modules/
dist/
.next/
*.tsbuildinfo
# deployment artefacts: manifests are generated per run
deploy/manifest.*.json
deploy/.keys/
.env
.env.*
!.env.example
# tsc output belongs in dist/, never next to the sources
**/src/**/*.js
**/src/**/*.js.map
# local run logs
claude-spec-run.log
# the wasm build of marginal-core, made by `make wasm-core`
crates/marginal-core-wasm/core.wasm
# the room image build: assembled context, compose file, app-compose and the image tar
room/image/out/
