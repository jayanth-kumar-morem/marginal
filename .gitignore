target/
.DS_Store
node_modules/
dist/
.next/
*.tsbuildinfo
# deployment artefacts: manifests are generated per run
deploy/manifest.*.json
deploy/.keys/
.env
.env.*
!.env.example
# tsc output belongs in dist/, never next to the sources
**/src/**/*.js
**/src/**/*.js.map
# local run logs
claude-spec-run.log
# the wasm build of marginal-core, made by `make wasm-core`
crates/marginal-core-wasm/core.wasm
# the room image build: assembled context, compose file, app-compose and the image tar
room/image/out/
# the embedder's weights and tokenizer: fetched by `make models`, pinned by room/models/*/SHA256SUMS
room/models/**/*.onnx
room/models/**/tokenizer.json
room/models/**/config.json
room/models/**/tokenizer_config.json
room/models/**/special_tokens_map.json
# the circuit's intermediate build output (E10.1). The two artefacts the room and the tests need —
# `build/formula_knowledge_v1.zkey` and `build/formula_knowledge_v1_js/formula_knowledge_v1.wasm` —
# are committed and pinned by circuits/SHA256SUMS: a re-run ceremony would produce a different
# proving key, and the committed verifying key has to match the one that proves.
circuits/ceremony/
circuits/build/*.r1cs
circuits/build/*.sym
circuits/build/*_0000.zkey
circuits/build/*.vkey.json
circuits/build/formula_knowledge_v1_js/generate_witness.js
circuits/build/formula_knowledge_v1_js/witness_calculator.js
# raw coverage data: `make cov-rust` writes one per instrumented binary, next to the crate
*.profraw

# Internal planning and research: kept on disk, out of the published repository.
docs/
moonshot-notes/
spec-notes/
MOONSHOT.md
SPEC-PROMPT.md
spec-template.md
tasks.md
